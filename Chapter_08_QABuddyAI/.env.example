# --- Answering LLM (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- Vector DB (defaults to config.yaml value; docker-compose overrides this) ---
# QDRANT_URL=http://localhost:6333

# --- JIRA ingestion (source #4) — REST equivalent of the MCP connection ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_JQL=project = QA ORDER BY updated DESC
