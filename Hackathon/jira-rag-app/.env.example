# Jira Cloud
JIRA_BASE_URL=https://testlearn.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token

# Nomic Embed (https://atlas.nomic.ai/)
NOMIC_API_KEY=your-nomic-api-key
NOMIC_EMBED_MODEL=nomic-embed-text-v1.5

# Chroma Cloud (https://www.trychroma.com/)
CHROMA_API_KEY=your-chroma-cloud-api-key
CHROMA_TENANT=your-chroma-tenant-id
CHROMA_DATABASE=your-chroma-database-name

# Groq (https://console.groq.com/)
GROQ_API_KEY=your-groq-api-key
# As specified in the project prompt. Verify against your Groq dashboard --
# Groq's public docs list "openai/gpt-oss-120b" and "openai/gpt-oss-20b",
# not "gpt-oss-12b". Override here if the exact id differs.
GROQ_MODEL=gpt-oss-12b
