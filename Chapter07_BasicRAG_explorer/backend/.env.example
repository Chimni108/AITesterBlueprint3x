# Groq - required for answer generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Nomic Embed (sentence-transformers, downloaded from Hugging Face on first use)
EMBED_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5

# ChromaDB (local, on-disk - nothing to install or start)
CHROMA_PATH=./chroma_data
COLLECTION_NAME=vwo_prd_chunks

# Source PDF - leave blank to use the bundled default (../data/PRDVWO.com.pdf)
PDF_PATH=

# Chunking + retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
