# Qdrant - leave QDRANT_URL unset to run embedded (on-disk, no server required).
# Set it (e.g. http://localhost:6333) to use a real Qdrant server/Docker instead.
QDRANT_URL=
QDRANT_PATH=./qdrant_data
COLLECTION_NAME=vwo_test_cases

# Models (downloaded from Hugging Face on first use)
EMBED_MODEL_NAME=BAAI/bge-m3
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
BGE_USE_FP16=true
INGEST_BATCH=16

# Openrouter - used for query rewriting and answer/test-case generation
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REWRITE_MODEL=deepseek/deepseek-v4-pro
GENERATION_MODEL=deepseek/deepseek-v4-pro

# Retrieval pipeline tunables (see README)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_N_HYBRID=20
TOP_K_RERANK=4
RRF_K=60
REWRITE_ENABLED=true
REWRITE_COUNT=3

# Flask
HOST=127.0.0.1
PORT=5050
SECRET_KEY=change-me-to-something-random
